{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "glucose-dashboard",
  "compatibility_date": "2026-07-23",
  "main": "src/index.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "glucose-dashboard-db",
      "database_id": "0dcd6985-3012-4188-94da-de5d9751ccab"
    }
  ]
}
